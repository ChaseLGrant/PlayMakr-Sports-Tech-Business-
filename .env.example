# ─────────────────────────────────────────────────────────────
# PlayMakr environment variables
# Copy to .env.local for local development. In production, set these in
# your host's dashboard (Vercel → Project → Settings → Environment Variables).
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser.
# ─────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Scheduling link shown after an application (Calendly, Cal.com, etc.). Optional.
NEXT_PUBLIC_CALENDAR_URL=

# ── Database (required in production) ───────────────────────
# Any PostgreSQL connection string. Supabase: Project Settings → Database →
# Connection string (use the "Transaction pooler" URI for serverless hosts).
# Leave empty locally to use the built-in embedded database (./.data/pglite).
DATABASE_URL=
DATABASE_POOL_MAX=5
# Set true to verify the database TLS certificate strictly (needs a trusted CA).
DATABASE_SSL_STRICT=false
# Run pending migrations automatically when the app connects. Prefer
# `npm run db:migrate` during deploys; this is a convenience switch.
AUTO_MIGRATE=false

# ── Security ─────────────────────────────────────────────────
# Long random string used to salt IP hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
IP_HASH_SALT=

# Cloudflare Turnstile spam protection (optional, recommended).
# https://dash.cloudflare.com → Turnstile → Add site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Email via Resend (optional) ──────────────────────────────
# https://resend.com → API Keys. EMAIL_FROM must use a verified domain.
RESEND_API_KEY=
EMAIL_FROM="PlayMakr <audits@yourdomain.com>"
# Where new-lead alerts go.
LEAD_NOTIFICATION_EMAIL=

# ── Slack alerts (optional) ──────────────────────────────────
# Incoming webhook URL. Messages include org name + score only (no contact info).
SLACK_WEBHOOK_URL=

# ── Conversion experiments ───────────────────────────────────
# true = split visitors 50/50 between hero A and hero B (sticky for 30 days).
HERO_SPLIT_TEST=false
# When not split testing, which hero to show: A or B.
HERO_VARIANT=A
# true = show the live "X / 100 founding partners enrolled" bar (from the database).
SHOW_FOUNDING_AVAILABILITY=false

# ── Local-only escape hatch ──────────────────────────────────
# Allows `next start` without DATABASE_URL (embedded DB). Never set in production.
ALLOW_EMBEDDED_DB=false
